{
  "version": 6,
  "remote": "origin",
  "developmentBranch": "develop",
  "productionBranch": "master",
  "concurrency": 3,
  "maxConcurrency": 20,
  "maxAttempts": 2,
  "defaultStartMode": "interactive",
  "conversationLanguage": "English",
  "pollCron": "*/2 * * * *",
  "nativeScheduler": {
    "enabled": true,
    "startWithOrchestrator": true,
    "intervalSeconds": 15,
    "maximumBackoffSeconds": 300
  },
  "workerPermissionMode": "auto",
  "workerAgent": "claude",
  "workerModel": "inherit",
  "workerEffort": "high",
  "codexCommand": "codex",
  "codexModel": "inherit",
  "codexReasoningEffort": "inherit",
  "autoPushDevelopment": true,
  "autoPromoteToProduction": true,
  "productionMode": "merge-develop",
  "allowUnrelatedDevelopCommitsToProduction": true,
  "integrationTestCommands": [],
  "releaseTestCommands": [],
  "testDatabaseIsolation": {
    "enabled": false,
    "provider": "postgresql",
    "databasePrefix": "",
    "connectionEnvironmentFile": ".env",
    "databaseEnvironmentVariable": "DB_DATABASE",
    "hostEnvironmentVariable": "DB_HOST",
    "portEnvironmentVariable": "DB_PORT",
    "usernameEnvironmentVariable": "DB_USERNAME",
    "passwordEnvironmentVariable": "DB_PASSWORD",
    "maintenanceDatabase": "postgres",
    "clientCommand": "psql"
  },
  "copyIgnoredFiles": [
    ".env",
    ".env.local",
    ".env.testing"
  ],
  "workerRequiredChecks": [
    "Run tests directly relevant to the changed behavior",
    "Run the nearest available lint or static-analysis command",
    "Add or update regression tests when practical"
  ],
  "asana": {
    "postStartComment": false,
    "postCompletionComment": false,
    "markCompleteAfterProduction": false
  }
}
