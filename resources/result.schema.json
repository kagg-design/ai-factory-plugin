{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Claude Factory Worker Result",
  "type": "object",
  "required": ["status", "taskId", "tests", "notes", "blockingReason"],
  "properties": {
    "status": {"enum": ["completed", "blocked", "failed"]},
    "taskId": {"type": "string", "minLength": 1},
    "branch": {"type": "string"},
    "commit": {"type": "string"},
    "worktree": {"type": "string"},
    "changedFiles": {
      "type": "array",
      "items": {"type": "string"}
    },
    "tests": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["command", "status", "summary"],
        "properties": {
          "command": {"type": "string"},
          "status": {"enum": ["passed", "failed", "skipped"]},
          "summary": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "notes": {"type": "string"},
    "blockingReason": {"type": "string"}
  },
  "allOf": [
    {
      "if": {
        "properties": {"status": {"const": "completed"}},
        "required": ["status"]
      },
      "then": {
        "required": ["branch", "commit", "worktree"],
        "properties": {
          "branch": {"minLength": 1},
          "commit": {"pattern": "^[0-9a-fA-F]{40}$"},
          "worktree": {"minLength": 1}
        }
      }
    }
  ],
  "additionalProperties": false
}
