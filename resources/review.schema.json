{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://claude-factory.local/schemas/review.schema.json",
  "title": "Claude Factory review decision",
  "type": "object",
  "additionalProperties": false,
  "required": ["commit", "verdict", "summary", "riskNotes"],
  "properties": {
    "commit": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{40}$"
    },
    "verdict": {
      "enum": ["approved", "changes-required", "blocked"]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "riskNotes": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "integrationTestCommands": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "releaseTestCommands": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
